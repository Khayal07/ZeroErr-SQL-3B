ZEROERR_APP_NAME=ZeroErr-SQL-3B
ZEROERR_ENGINE_BACKEND=ollama
ZEROERR_OLLAMA_BASE_URL=http://localhost:11434
ZEROERR_OLLAMA_MODEL=zeroerr:3b
ZEROERR_SANDBOX_ENGINE=sqlite
ZEROERR_SANDBOX_DATA_DIR=data/databases
ZEROERR_SANDBOX_TIMEOUT_SECONDS=5
ZEROERR_SANDBOX_MAX_ROWS=100
ZEROERR_MAX_RETRY_ROUNDS=3
ZEROERR_RESULTS_DIR=eval/results